# ==========================================
# SaansSaathi Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or your actual API keys to GitHub!

# 1. CPCB / India OGD Data API Key (Required for live official station AQI)
# Get your free key at: https://data.gov.in/ (Register -> My Dashboard -> API Key)
# Resource ID: 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69 (Real-time National AQI)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# 2. Google Gemini Developer API Key (Required for personalized AI recommendations)
# Get your key at: https://aistudio.google.com/
# Model used: gemini-3.8-flash (Interactions API / v1)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional configuration flags
# Set USE_MOCK_AQI=true (server-side, preferred) to force mock CPCB data for offline testing or CI.
# NEXT_PUBLIC_USE_MOCK_AQI is accepted as a legacy alias but MUST be false in production.
# WARNING: Never set NEXT_PUBLIC_USE_MOCK_AQI=true in Vercel production env — it exposes flag in JS bundle.
USE_MOCK_AQI=false
NEXT_PUBLIC_USE_MOCK_AQI=false

# 3. Optional Distributed Rate Limiting (Upstash Redis)
# Recommended for Vercel production to protect expensive Gemini AI endpoint (/api/recommendations)
# across distributed serverless function instances.
# Free registration at: https://console.upstash.com/ (Create Database -> REST API)
# If omitted, SaansSaathi automatically falls back to in-memory rate limiting with zero downtime.
# Basic AQI viewing NEVER requires Redis.
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
